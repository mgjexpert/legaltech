{
  "name": "family-resolution-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fro/web",
    "build": "npm run build --workspace @fro/web",
    "start": "npm run start --workspace @fro/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @fro/web",
    "test": "vitest run",
    "test:db": "tsx scripts/test-db.ts",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:generate": "node scripts/check-docs.mjs --write",
    "check": "npm run check:docs && npm run typecheck && npm test && npm run test:db && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@playwright/test": "1.63.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
